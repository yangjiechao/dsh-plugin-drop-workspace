{
  "name": "dsh-plugin-drop-workspace",
  "version": "1.0.0",
  "description": "Drop a folder anywhere on the DeepSeek Harness Web GUI to register it as a project (workspace) on the host machine.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "deepseek-harness",
    "workspace",
    "project",
    "drag-and-drop"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "search.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
